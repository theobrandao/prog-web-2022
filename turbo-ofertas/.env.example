ADMIN_EMAIL=                # bootstrap: o primeiro admin é criado no seed com este e-mail
ADMIN_PASSWORD=             # senha inicial do admin (trocável na primeira sessão)
SESSION_SECRET=             # chave da assinatura do cookie de sessão
DATABASE_URL=file:../data/app.db
PUBLIC_BASE_URL=            # HTTPS público; a Graph API busca as imagens por aqui
GROUP_INVITE_URL=           # convite do grupo/canal; rodapé de toda mensagem (loop de crescimento)
# Telegram (fase 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_PRIVATE_CHAT_ID=   # chat do operador: pacote WhatsApp e alertas
# Instagram (fase 4) — conta profissional vinculada a Página do Facebook
IG_USER_ID=
IG_ACCESS_TOKEN=            # longa duração (~60 dias); renovação documentada no README
# Shopee (fase 6)
SHOPEE_APP_ID=
SHOPEE_SECRET=
